{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Food Chain Magnate map tiles (data/tiles.json)",
  "description": "20 base tiles, each a 5x5 grid of squares at rotation 0. Roads are whole squares; see roadRules.",
  "type": "object",
  "required": [
    "size",
    "tiles"
  ],
  "properties": {
    "size": {
      "const": 5
    },
    "tiles": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "$ref": "#/definitions/tile"
      }
    }
  },
  "definitions": {
    "tile": {
      "type": "object",
      "required": [
        "id",
        "rows",
        "houses"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-T]$"
        },
        "rows": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "string",
            "pattern": "^[.#Hsbl]{5}$"
          }
        },
        "houses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "number",
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "number": {
                "type": "integer"
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              }
            },
            "description": "2x2 printed house; (x,y) is its top-left square."
          }
        }
      }
    }
  }
}
